rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuário logado com e-mail Google verificado
    function logado() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // E-mail cadastrado na coleção "autorizados" (ID do documento = e-mail em minúsculas)
    function autorizado() {
      return logado()
        && exists(/databases/$(database)/documents/autorizados/$(request.auth.token.email.lower()));
    }

    // Uma coleção por núcleo do setor: SCP e Processamento de Dados
    function colecaoDeNucleo(colecao) {
      return colecao in ['processos_scp', 'processos_pd'];
    }

    function processoValido(d) {
      return d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 500
        && d.quem is string && d.quem.size() <= 200
        && d.urgencia in ['Critica', 'Alta', 'Media', 'Baixa']
        && d.status in ['Pendente', 'Em Andamento', 'Aguardando', 'Concluido']
        && d.progresso is string && d.progresso.size() <= 1000
        && d.obs is string && d.obs.size() <= 5000
        && d.itens is list && d.itens.size() <= 200
        && d.get('notificacao', false) is bool
        && d.get('transferidoDe', '') is string
        && d.get('transferidoPor', '') is string
        && (!d.keys().hasAny(['transferidoEm']) || d.transferidoEm is timestamp);
    }

    // Cadastro comum: criado agora, pela própria pessoa, sem histórico de atualização/transferência
    function criacaoComum(d) {
      return d.criadoEm == request.time
        && d.criadoPor == request.auth.token.email
        && !d.keys().hasAny(['transferidoPor', 'transferidoEm', 'atualizadoEm', 'atualizadoPor']);
    }

    // Transferência entre núcleos: o documento mantém o ID e é criado no mesmo batch que
    // apaga o original na outra coleção. Criação e última atualização vêm do original.
    function transferenciaValida(colecao, id, d) {
      let origem = /databases/$(database)/documents/$(d.transferidoDe)/$(id);
      return d.keys().hasAll(['transferidoPor', 'transferidoEm'])
        && colecaoDeNucleo(d.transferidoDe) && d.transferidoDe != colecao
        && d.transferidoPor == request.auth.token.email
        && d.transferidoEm == request.time
        && exists(origem) && !existsAfter(origem)
        && !d.diff(get(origem).data).affectedKeys().hasAny(['criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor']);
    }

    // Lista de acesso: cada pessoa só consegue ver se o próprio e-mail está liberado.
    // Adicionar/remover pessoas é feito apenas pelo Firebase Console.
    match /autorizados/{email} {
      allow read: if logado() && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    match /{colecao}/{id} {
      allow read: if colecaoDeNucleo(colecao) && autorizado();

      allow create: if colecaoDeNucleo(colecao) && autorizado()
        && request.resource.data.keys().hasOnly(['descricao', 'quem', 'urgencia', 'status', 'progresso', 'itens', 'obs', 'criadoEm', 'criadoPor', 'notificacao', 'transferidoDe', 'transferidoPor', 'transferidoEm', 'atualizadoEm', 'atualizadoPor'])
        && processoValido(request.resource.data)
        && (request.resource.data.keys().hasAny(['transferidoDe'])
              ? transferenciaValida(colecao, id, request.resource.data)
              : criacaoComum(request.resource.data));

      allow update: if colecaoDeNucleo(colecao) && autorizado()
        && request.resource.data.keys().hasOnly(['descricao', 'quem', 'urgencia', 'status', 'progresso', 'itens', 'obs', 'criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor', 'notificacao', 'transferidoDe', 'transferidoPor', 'transferidoEm'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['criadoEm', 'criadoPor', 'transferidoDe', 'transferidoPor', 'transferidoEm'])
        && processoValido(request.resource.data)
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.atualizadoPor == request.auth.token.email;

      allow delete: if colecaoDeNucleo(colecao) && autorizado();
    }

    // Qualquer outra coleção fica bloqueada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
